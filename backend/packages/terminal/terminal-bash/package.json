{
  "name": "@deepseek-ai/dsh-terminal-bash",
  "description": "Persistent shell PTY backend over the DeepSeek Harness subprocess terminal primitive",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-terminal": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.1",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-lazy-require": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-pwsh-local": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@xterm/headless": "^6.0.0"
  }
}
